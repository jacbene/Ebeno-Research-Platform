# ═══════════════════════════════════════════════════════════════════
# EBENO RESEARCH PLATFORM — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Usage :
#   cp backend/.env.example backend/.env
#   → puis éditer les valeurs marquées "CHANGE_ME" ou "<obligatoire>"
#
# Modes de déploiement :
#   - SaaS Cloud (Render)       → Ollama désactivé (OLLAMA_URL vide)
#   - Self-Hosted (Docker)      → Ollama activé (OLLAMA_URL=http://ollama:11434)
#   - Dev local                 → Ollama optionnel (OLLAMA_URL=http://localhost:11434)
#
# ⚠️ NE JAMAIS COMMITER backend/.env (déjà dans .gitignore)
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 1. RUNTIME
# ───────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | production
PORT=5001                               # port HTTP du backend
LOG_LEVEL=info                          # debug | info | warn | error

# ───────────────────────────────────────────────────────────────────
# 2. BASE DE DONNÉES (PostgreSQL)
# ───────────────────────────────────────────────────────────────────
# Dev local      : postgresql://postgres:postgres@localhost:5432/ebeno
# Self-Hosted    : postgresql://ebeno:<password>@db:5432/ebeno
# SaaS (Neon)    : postgresql://...@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://ebeno:ebeno_dev_password@db:5432/ebeno

# Pool de connexions Knex
DB_POOL_MIN=2
DB_POOL_MAX=10

# ───────────────────────────────────────────────────────────────────
# 3. AUTHENTIFICATION
# ───────────────────────────────────────────────────────────────────
# ⚠️ OBLIGATOIRE — générer avec :
#    node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_byte_hex_string
JWT_EXPIRES_IN=7d                       # durée de vie des tokens

# Hash des mots de passe (bcrypt)
BCRYPT_ROUNDS=10

# ───────────────────────────────────────────────────────────────────
# 4. CORS
# ───────────────────────────────────────────────────────────────────
# Liste séparée par virgules (pas d'espace)
# Dev local   : http://localhost:5173,http://localhost:4173
# Self-Hosted : http://localhost:80,http://localhost
# SaaS        : https://ebenoresearch.com,https://www.ebenoresearch.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# URL du frontend (utilisée dans les emails, redirections OAuth, etc.)
FRONTEND_URL=http://localhost:5173

# ───────────────────────────────────────────────────────────────────
# 5. IA — OLLAMA (self-hosted prioritaire)
# ───────────────────────────────────────────────────────────────────
# ⚠️ LAISSER VIDE EN SAAS CLOUD (Render)
#    Si vide → cascade saute Ollama et appelle directement DeepSeek/OpenAI
#    Si défini → Ollama tenté en premier, fallback cloud si échec
#
# Dev local    : OLLAMA_URL=http://localhost:11434
# Self-Hosted  : OLLAMA_URL=http://ollama:11434
# SaaS (Render): OLLAMA_URL=           (laisser vide)
OLLAMA_URL=

# Modèle Ollama à utiliser
# Recommandé : llama3.1 (8B, ~5GB) — bon compromis qualité/vitesse CPU
# Alternatifs : mistral (7B), qwen2.5:7b, llama3.2:3b (plus rapide, moins bon)
OLLAMA_MODEL=llama3.1

# Legacy (ne plus utiliser, gardé pour compat) — sera unifié avec OLLAMA_URL
# OLLAMA_BASE_URL=

# ───────────────────────────────────────────────────────────────────
# 6. IA — DEEPSEEK (cloud fallback)
# ───────────────────────────────────────────────────────────────────
# Clé API : https://platform.deepseek.com/api_keys
# Sans cette clé, le chat IA et l'analyse thématique échoueront en SaaS
DEEPSEEK_API_KEY=sk-CHANGE_ME

# ───────────────────────────────────────────────────────────────────
# 7. IA — OPENAI (fallback final)
# ───────────────────────────────────────────────────────────────────
# Clé API : https://platform.openai.com/api-keys
# Utilisé uniquement si DeepSeek échoue
OPENAI_API_KEY=sk-CHANGE_ME

# ───────────────────────────────────────────────────────────────────
# 8. IA — DEEPGRAM (transcription audio)
# ───────────────────────────────────────────────────────────────────
# Clé API : https://console.deepgram.com/
DEEPGRAM_API_KEY=CHANGE_ME

# Fallback transcription via OpenAI Whisper (si Deepgram échoue)
# Utilise OPENAI_API_KEY ci-dessus

# ───────────────────────────────────────────────────────────────────
# 9. STOCKAGE — CLOUDINARY
# ───────────────────────────────────────────────────────────────────
# Dashboard : https://cloudinary.com/console
# ⚠️ En self-hosted "pur" (souveraineté), envisager MinIO en alternative
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ───────────────────────────────────────────────────────────────────
# 10. EMAIL — BREVO
# ───────────────────────────────────────────────────────────────────
# Dashboard : https://app.brevo.com/settings/keys/api
# Domaine authentifié requis (SPF/DKIM/DMARC)
BREVO_API_KEY=xkeysib-CHANGE_ME
BREVO_FROM_EMAIL=noreply@ebenoresearch.com
BREVO_FROM_NAME=Ebeno Research

# ───────────────────────────────────────────────────────────────────
# 11. MONITORING — SENTRY
# ───────────────────────────────────────────────────────────────────
# Dashboard : https://sentry.io/settings/projects/
# Laisser vide en self-hosted si souveraineté totale requise
SENTRY_DSN=

# ───────────────────────────────────────────────────────────────────
# 12. PWA — NOTIFICATIONS PUSH (VAPID)
# ───────────────────────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@ebenoresearch.com

# ───────────────────────────────────────────────────────────────────
# 13. WEBHOOKS (utilisateurs)
# ───────────────────────────────────────────────────────────────────
# Secret HMAC partagé pour signer les webhooks sortants
WEBHOOK_SIGNING_SECRET=CHANGE_ME
WEBHOOK_RETRY_INTERVAL_MS=60000

# ───────────────────────────────────────────────────────────────────
# 14. RATE LIMITING
# ───────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000             # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────────────
# 15. QUOTAS IA (par plan)
# ───────────────────────────────────────────────────────────────────
AI_QUOTA_FREE=50                        # messages/mois plan Free
AI_QUOTA_PRO=2000                       # messages/mois plan Pro
AI_QUOTA_INSTITUTION=10000              # pool partagé Institution

# ───────────────────────────────────────────────────────────────────
# 16. DIVERS
# ───────────────────────────────────────────────────────────────────
# URL publique du backend (pour construire des liens absolus)
BACKEND_PUBLIC_URL=http://localhost:5001

# Environnement (informatif)
APP_VERSION=2.0.0

# Fuseau horaire
TZ=Africa/Douala
