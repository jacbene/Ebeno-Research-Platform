# ═══════════════════════════════════════════════════════════
# .env — variables lues par `docker compose` (RACINE du dépôt)
#
#   cp .env.example .env
#   nano .env        # personnaliser les valeurs vides
#
# ⚠️ Ce fichier est le SEUL lu par docker compose pour l'interpolation
#    ${VAR}. Le fichier backend/.env ne sert qu'au développement local
#    (npm run dev hors Docker).
# ═══════════════════════════════════════════════════════════

# ─── Sécurité (OBLIGATOIRE) ───────────────────────────────
# Générer : openssl rand -hex 32
# `docker compose` refuse de démarrer si cette valeur est vide.
JWT_SECRET=

# ─── Base de données ──────────────────────────────────────
# ⚠️ Si vous changez le mot de passe ici, changez-le aussi dans le
#    service `db` de docker-compose.yml (POSTGRES_PASSWORD).
POSTGRES_PASSWORD=ebeno_secret
DATABASE_URL=postgres://ebeno:ebeno_secret@db:5432/ebeno_db

# ─── Stockage fichiers ────────────────────────────────────
# cloudinary (SaaS) | minio (self-hosted)
STORAGE_PROVIDER=minio

# Credentials MinIO — générer :
#   openssl rand -hex 16   (access key)
#   openssl rand -hex 32   (secret key)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ebeno-files

# URL publique utilisée pour construire les liens des fichiers stockés.
# ⚠️ En production / test distant, remplacer localhost par l'IP ou le domaine
#    du serveur, sinon les fichiers uploadés seront inaccessibles aux clients.
MINIO_PUBLIC_URL=http://localhost:9000

# ─── IA locale ────────────────────────────────────────────
# (valeurs déjà fixées dans docker-compose.yml pour le réseau interne)
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.1

# ─── Clés optionnelles (fallback cloud) ───────────────────
# Laisser vides pour une souveraineté totale.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
