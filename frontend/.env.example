# ═══════════════════════════════════════════════════════════════════
# EBENO RESEARCH PLATFORM — Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# ⚠️ IMPORTANT : Vite n'expose au bundle client QUE les variables
#    préfixées par VITE_. Tout ce qui n'a pas ce préfixe est ignoré.
#
# Usage :
#   cp frontend/.env.example frontend/.env.local    (dev)
#   cp frontend/.env.example frontend/.env.production (build prod)
#
# ⚠️ NE JAMAIS mettre de secrets ici (API keys serveur, etc.)
#    Ce fichier est bundlé dans le JS livré au navigateur.
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# 1. API BACKEND
# ───────────────────────────────────────────────────────────────────
# Dev local    : http://localhost:5001
# Self-Hosted  : http://localhost/api  (Nginx reverse proxy)
# SaaS (prod)  : https://ebeno-backend.onrender.com
VITE_API_URL=http://localhost:5001

# ───────────────────────────────────────────────────────────────────
# 2. SOCKET.IO
# ───────────────────────────────────────────────────────────────────
# Doit pointer vers le MÊME host que VITE_API_URL
# (le namespace /chat est monté sur le même serveur)
VITE_SOCKET_URL=http://localhost:5001

# ───────────────────────────────────────────────────────────────────
# 3. MONITORING — SENTRY
# ───────────────────────────────────────────────────────────────────
# Dashboard : https://sentry.io/settings/projects/
# Laisser vide pour désactiver en self-hosted
VITE_SENTRY_DSN=

# Environnement Sentry (development | staging | production)
VITE_SENTRY_ENV=development

# ───────────────────────────────────────────────────────────────────
# 4. PWA — NOTIFICATIONS PUSH (VAPID)
# ───────────────────────────────────────────────────────────────────
# ⚠️ SEULE la clé PUBLIQUE va ici (la privée reste backend)
# Doit correspondre à VAPID_PUBLIC_KEY du backend
VITE_VAPID_PUBLIC_KEY=CHANGE_ME

# ───────────────────────────────────────────────────────────────────
# 5. APP METADATA
# ───────────────────────────────────────────────────────────────────
VITE_APP_NAME=Ebeno Research
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development                # development | production

# ───────────────────────────────────────────────────────────────────
# 6. FEATURE FLAGS (optionnel)
# ───────────────────────────────────────────────────────────────────
# Activer/désactiver des fonctionnalités sans rebuild
VITE_FEATURE_CAQDAS=true
VITE_FEATURE_AI_CHAT=true
VITE_FEATURE_SELF_HOSTED_HINT=false     # affiche un badge "self-hosted" dans l'UI

# ───────────────────────────────────────────────────────────────────
# 7. I18N
# ───────────────────────────────────────────────────────────────────
# Langue par défaut si aucune préférence utilisateur détectée
VITE_DEFAULT_LOCALE=fr                  # fr | en | es | pt | ar
