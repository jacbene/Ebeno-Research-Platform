/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://api.cloudinary.com https://*.onrender.com; font-src 'self' data:; connect-src 'self' https://*.onrender.com wss://*.onrender.com https://res.cloudinary.com https://api.cloudinary.com https://api.brevo.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io wss:; media-src 'self' blob: https://res.cloudinary.com https://*.onrender.com; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
